{
  "name": "@mzigo/bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Location plane: MQTT → Postgres ingest, outbox → MQTT relay, public snapshots, fraud checks.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/main.js --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@mzigo/contracts": "workspace:*",
    "mqtt": "5.16.0",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "aedes": "1.2.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.4",
    "jose": "6.2.12"
  }
}
