{
  "name": "@mzigo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HTTP API (control plane). Runs on Cloudflare Workers; core logic is plain TypeScript tested against a real Postgres.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build:check": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@mzigo/contracts": "workspace:*",
    "hono": "4.13.13",
    "jose": "6.2.12",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261014.1",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.4",
    "wrangler": "4.151.0"
  }
}
