# Copy to .env next to docker-compose.yml. Never commit .env.
EMQX_NODE_COOKIE=change-me-long-random
# Must equal the API's MQTT_JWT_SECRET (wrangler secret).
MQTT_JWT_SECRET=change-me-long-random
# Must match the bridge row in emqx/auth-bootstrap.csv.
BRIDGE_MQTT_PASSWORD=change-me-long-random
# Postgres (Supabase: use the direct or session-pooler connection string; the bridge uses LISTEN/NOTIFY).
DATABASE_URL=postgres://postgres:password@db.example.supabase.co:5432/postgres
