{
  "name": "@mzigo/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MzigoFasta web app: customer, driver, public tracking link and admin. React Native components rendered with react-native-web, deployed to Cloudflare Pages.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "deploy": "pnpm build && wrangler pages deploy dist --project-name mzigofasta-web"
  },
  "dependencies": {
    "@mzigo/contracts": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-native-svg": "^15.15.5",
    "react-native-web": "^0.21.4",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react-native": "0.77.3",
    "typescript": "7.0.2",
    "vite": "^8.3.4",
    "wrangler": "4.151.0"
  }
}
